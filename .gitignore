# ---------- Node / API (app/) ----------
node_modules/
dist/
build/
*.tsbuildinfo
coverage/
.nyc_output/

# Logs
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# temp directory
.temp
.tmp

# ---------- Segredos ----------
# Variáveis de ambiente reais (só o .env.example é versionado)
.env
.env.*
!.env.example

# Chaves SSH (ex.: labsuser.pem do Learner Lab)
*.pem
*.key

# ---------- Terraform (infra/) ----------
# Providers/módulos baixados pelo terraform init
.terraform/
.terraform.lock.hcl

# Credenciais temporárias do Learner Lab
aws-creds.sh

# State local contém a senha do banco em texto plano
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
crash.log
crash.*.log

# Variáveis reais (IP pessoal, senhas). Só o .example vai para o Git.
*.tfvars
*.tfvars.json
!*.tfvars.example

# Planos salvos também carregam valores sensíveis
*.tfplan
tfplan

override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ---------- SO / editores ----------
.DS_Store
Thumbs.db
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.vscode/*
!.vscode/settings.json
