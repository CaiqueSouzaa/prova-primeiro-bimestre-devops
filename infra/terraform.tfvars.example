# terraform.tfvars.example
# Copie para terraform.tfvars e ajuste os valores antes de aplicar.
# NUNCA versione o terraform.tfvars (está no .gitignore).

# ── Variáveis obrigatórias ──────────────────────────────────────────────────

# Senha do RDS: use apenas caracteres alfanuméricos.
# O RDS rejeita: / @ " e espaço.
db_password = "Troque-por-uma-senha-forte-123"

